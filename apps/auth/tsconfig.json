{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": [
      "ES2022"
    ],
    "outDir": "./dist",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@auth/*": [
        "./src/*"
      ],
      "@workspace/common": [
        "../../src/index.ts"
      ],
      "@workspace/common/*": [
        "../../src/*"
      ]
    }
  },
  "include": [
    "src",
    "index.ts",
    "../../src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}