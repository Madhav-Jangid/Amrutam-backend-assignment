{
  "name": "workspace",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "src"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "dev": "npm run dev --workspaces",
    "create-service": "sh scripts/create-service.sh",
    "dev:monolith": "nodemon -r tsconfig-paths/register src/monolith.ts"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.16",
    "eslint": "^8.56.0",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.3"
  }
}